{
  "name": "lesson-app-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "db:generate": "npx prisma generate",
    "db:reset": "node -e \"if(process.env.ALLOW_DB_WIPE!=='yes'){console.error('Refusing: this DROPS EVERY TABLE incl. the worksheet library. Local DBs only: ALLOW_DB_WIPE=yes npm run db:reset');process.exit(1)}\" && npx prisma migrate reset --force && ALLOW_DEMO_SEED=yes node prisma/seed.js",
    "db:deploy": "npx prisma migrate deploy",
    "qa:seed": "node scripts/qa-data.js seed",
    "qa:cleanup": "node scripts/qa-data.js cleanup",
    "test:smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.10.2"
  }
}
